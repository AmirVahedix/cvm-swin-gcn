# CVM Backend API Data Source Configuration
CVM_API_URL=http://localhost:8000
CVM_API_TOKEN=your_cvm_api_token_here

VAST_API_KEY=your_vast_api_key
VAST_INSTANCE_ID=your_instance_id

GITHUB_TOKEN=your_github_token
GITHUB_USER=your_github_username

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=cvm-swin-gcn
MLFLOW_TRACKING_USERNAME=your_mlflow_username
MLFLOW_TRACKING_PASSWORD=your_mlflow_password

